{
  "name": "recall-lab",
  "version": "0.4.0",
  "description": "Spaced-repetition reviews, tiered exams, CTF-style labs and a skill radar over your notes, marked and written by Claude through the Claude Code CLI. No API key.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node test/run.mjs",
    "check": "node scripts/check-release.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "spaced-repetition",
    "fsrs",
    "flashcards",
    "quiz",
    "ctf",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MYounas126/recall-lab.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "builtin-modules": "^5.4.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.7.2",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  },
  "dependencies": {
    "ts-fsrs": "5.4.2"
  }
}
